RTC_DEPLOYMENT_MODE=lan
# Example only: configure a dedicated least-privilege local DB user and private credentials.
DATABASE_URL=postgresql+psycopg://rtc@127.0.0.1/rtc
RTC_BIND_HOST=127.0.0.1
RTC_PORT=8000
RTC_TRUSTED_HOSTS=rtc.internal,localhost,127.0.0.1
RTC_DB_POOL_SIZE=10
RTC_DB_MAX_OVERFLOW=10
RTC_DB_STATEMENT_TIMEOUT_MS=15000
RTC_MAX_CONNECTIONS=200
# Local TLS proxy should bind the trusted LAN interface; root token stays server-side.
