RTC_DEPLOYMENT_MODE=standalone
DATABASE_URL=sqlite:///rtc.db
RTC_BIND_HOST=127.0.0.1
RTC_PORT=8000
# Supply RTC_ADMIN_TOKEN privately, generated with secrets.token_urlsafe(32).
RTC_MANAGED_RUNTIME=1
RTC_REQUESTS_PER_MINUTE=300
RTC_LOG_MAX_BYTES=2000000
RTC_LOG_BACKUPS=3
RTC_CLEANUP_SECONDS=60
RTC_DISK_MIN_FREE_BYTES=1073741824
